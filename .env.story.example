# Copy this file to .env.story.local and fill in your values locally.
# Never commit .env.story.local or paste real API keys into chat.

# --- Active series ---
# Relative path from repo root. Change this when you create your own series.
PIPELINE_SERIES_DIR=examples/phone_from_tomorrow

# --- OpenAI (required for scene images and cover backgrounds) ---
OPENAI_API_KEY=
OPENAI_IMAGE_STRICT=1
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_TIMEOUT_SECONDS=180

# --- ElevenLabs (required for narrator voiceover) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# --- Optional: fal.ai for AI video clips instead of local motion ---
FAL_KEY=
PIPELINE_VIDEO_MODE=local

# --- Video render ---
EPISODE_COVER_INTRO_SECONDS=2.5
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# --- Notifications (optional) ---
PIPELINE_NOTIFY_ON_RUN=true
PIPELINE_NOTIFY_EMAIL=

# SMTP is required for actual email delivery. Without it, pending notification
# files are written under your series notifications/ folder.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
