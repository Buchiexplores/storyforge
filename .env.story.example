# Copy this file to .env.story.local and fill in your values locally.
# Never commit .env.story.local or paste real API keys into chat.

# --- Active series ---
# Your working series lives under series/ (created by init_series.py).
# examples/ is for published demo stories shipped with the repo — do not point here for daily work.
# Set after scaffolding, e.g. series/the_last_signal
PIPELINE_SERIES_DIR=

# --- OpenAI (required for scene images and cover backgrounds) ---
OPENAI_API_KEY=
OPENAI_IMAGE_STRICT=1
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_TIMEOUT_SECONDS=180
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TEXT_TIMEOUT_SECONDS=180

# --- ElevenLabs (required for narrator voiceover) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# --- Optional: fal.ai for AI video clips instead of local motion ---
FAL_KEY=
PIPELINE_VIDEO_MODE=local
# When PIPELINE_VIDEO_MODE=fal, pick the image-to-video model:
# FAL_VIDEO_MODEL=bytedance/seedance-2.0/image-to-video   # default — ByteDance Seedance 2.0
# FAL_VIDEO_MODEL=fal-ai/veo3/image-to-video              # Google Veo 3 (i2v with audio)
# FAL_VIDEO_MODEL=fal-ai/veo3.1/image-to-video            # Google Veo 3.1 (latest i2v)
# FAL_VIDEO_MODEL=bytedance/seedance-2.0/fast/image-to-video  # faster/cheaper Seedance

# --- Video render ---
EPISODE_COVER_INTRO_SECONDS=2.5
# setup.sh auto-detects ffmpeg/ffprobe and writes these paths into .env.story.local
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# --- Notifications (optional) ---
PIPELINE_NOTIFY_ON_RUN=true
# Who receives pipeline emails (comma-separated for multiple addresses)
PIPELINE_NOTIFY_EMAIL=

# SMTP is required for actual email delivery. Without it, pending notification
# files are written under your series notifications/ folder.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Legacy aliases (still supported by send_pipeline_update.py — prefer SMTP_* above):
# EMAIL_SENDER=       # alias for SMTP_USERNAME / SMTP_FROM_EMAIL
# EMAIL_PASSWORD=     # alias for SMTP_PASSWORD
# EMAIL_RECEIVER=     # alias for PIPELINE_NOTIFY_EMAIL
